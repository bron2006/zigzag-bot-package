# Narrow reliability release over the exact running, rollback-compatible image.
# Original dependency rebuild currently fails on upstream Debian mirror 404s.
# Verified clean full-build release v1490. Do not go back to pre-cleanup
# images: deleting a session in a later layer does not erase the old layer.
FROM registry.fly.io/zigzag-bot-package:deployment-01M4KG696VTAT31B5X3CDTK56M@sha256:9d3ca5634b4768d08663237df5cfe57f24ce86be1d7ac9c988085aba16b38b04
WORKDIR /app
# Old base images may contain a copied local browser session. Never restore
# that file or local-only executors during a code-only emergency release.
RUN rm -f /app/storage_state.json /app/.env /app/binomo_executor.py /app/vwap_executor.py
COPY app.py api.py db.py scanner.py signal_tracking.py state.py endpoint_sampler.py signal_accounting.py measurement_health.py telegram_ui.py ctrader.py spotware_connect.py ./
COPY webapp/script.js ./webapp/script.js
COPY webapp/index.html ./webapp/index.html
COPY paper_stop_view.py paper_stop_journal.py paper_cfd.py paper_stop_runtime.py ./
COPY historical_endpoints.py ./
COPY notifier.py ./
COPY publication_tracking.py ./
RUN python -m py_compile app.py api.py db.py scanner.py signal_tracking.py state.py endpoint_sampler.py signal_accounting.py measurement_health.py ctrader.py spotware_connect.py
CMD ["python", "app.py"]
