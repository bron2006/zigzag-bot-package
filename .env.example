APP_MODE=full
PORT=8080
FLY_APP_NAME=zigzag-bot-package

DATABASE_URL=sqlite:////data/zigzag.db

TELEGRAM_BOT_TOKEN=
CHAT_ID=
MY_TELEGRAM_ID=
# DEV_MODE_UNSAFE_AUTH_BYPASS=true повністю вимикає перевірку Telegram initData
# (будь-хто зможе видавати себе за DEV_USER_ID). Лише для локальної розробки.
# НІКОЛИ не встановлюйте true на Fly.io чи будь-якому продакшн-середовищі.
DEV_MODE_UNSAFE_AUTH_BYPASS=false

CT_CLIENT_ID=
CT_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
DEMO_ACCOUNT_ID=

# News-фільтр читає економічний календар напряму, API-ключ не потрібен.
# NEWS_CALENDAR_URL=https://tool.forex/economic-calendar

IDEAL_ENTRY_THRESHOLD=78
SCANNER_TIMEFRAME=1m
SCANNER_COOLDOWN_SECONDS=300
MIN_ATR_PERCENTAGE=0.05
TWISTED_REACTOR_THREADS=12
WSGI_POOL_MIN=4
WSGI_POOL_MAX=20
BLOCKING_POOL_MIN=2
BLOCKING_POOL_MAX=12
