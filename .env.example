APP_MODE=full
PORT=8080
FLY_APP_NAME=zigzag-bot-package

DATABASE_URL=sqlite:////data/zigzag.db

TELEGRAM_BOT_TOKEN=
CHAT_ID=
MY_TELEGRAM_ID=
# DEV_MODE_UNSAFE_AUTH_BYPASS=true повністю вимикає перевірку Telegram initData
# (будь-хто зможе видавати себе за DEV_USER_ID). Лише для локальної розробки.
# НІКОЛИ не встановлюйте true на Fly.io чи будь-якому продакшн-середовищі.
DEV_MODE_UNSAFE_AUTH_BYPASS=false

# Необов'язковий секрет: дозволяє відкривати Web App поза Telegram (напр. у
# звичайному браузері) за посиланням ?admin_token=<це_значення>. Завжди
# резолвиться як DEV_USER_ID, не як довільний користувач. НЕ встановлюйте,
# якщо ця можливість не потрібна; тримайте значення в секреті.
# ADMIN_ACCESS_TOKEN=

CT_CLIENT_ID=
CT_CLIENT_SECRET=
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
DEMO_ACCOUNT_ID=

# News-фільтр читає економічний календар напряму, API-ключ не потрібен.
# NEWS_CALENDAR_URL=https://tool.forex/economic-calendar

IDEAL_ENTRY_THRESHOLD=78
SCANNER_TIMEFRAME=1m
SCANNER_COOLDOWN_SECONDS=300
MIN_ATR_PERCENTAGE=0.05
TWISTED_REACTOR_THREADS=12
WSGI_POOL_MIN=4
WSGI_POOL_MAX=20
BLOCKING_POOL_MIN=2
BLOCKING_POOL_MAX=12

# Signal outcome tracking (Part 1) - binary-option-style (up/down/flat over
# a fixed horizon). Defaults are usually fine.
# SIGNAL_OUTCOME_CHECK_INTERVAL_MINUTES=1
# SIGNAL_OUTCOME_FLAT_THRESHOLD_PERCENT=0.02
# ML_BUY_SCORE_THRESHOLD=75
# ML_SELL_SCORE_THRESHOLD=25

# Autotrader (Part 3, cTrader direct orders) - disabled by default.
# AUTOTRADE_ACCOUNT_MODE has NO Telegram/Web App toggle anywhere in the code
# on purpose: switching to 'live' means editing this on Fly.io and
# redeploying, deliberately, never something a bot command can flip.
AUTOTRADE_ENABLED=false
AUTOTRADE_ACCOUNT_MODE=demo
MAX_RISK_PERCENT_PER_TRADE=1.0
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_PERCENT=5.0

# ------------------------------------------------------------------
# Binomo executor (Part 3) - binomo_executor.py runs LOCALLY, not on
# Fly.io. These belong in a LOCAL .env on the machine running it, not on
# Fly.io secrets (except the cloud side still needs ADMIN_ACCESS_TOKEN
# above, which the local executor also uses to read /api/signal-stream and
# /api/live_price from the cloud instance).
# ------------------------------------------------------------------
BINOMO_EXECUTOR_ENABLED=false
BINOMO_ACCOUNT_MODE=demo
BINOMO_STAKE_PERCENT=1.0
BINOMO_MAX_TRADES_PER_DAY=10
BINOMO_MAX_CONSECUTIVE_LOSSES=4
BINOMO_MAX_DAILY_LOSS_PERCENT=5.0
# Only used by `python binomo_executor.py --login` if you want it to fill
# the login form for you (you still solve any CAPTCHA/2FA yourself) -
# leave blank to always log in fully manually.
BINOMO_EMAIL=
BINOMO_PASSWORD=
BINOMO_STORAGE_STATE_PATH=storage_state.json
BINOMO_HEADLESS=false
BINOMO_ASSET_MAP_PATH=data/binomo_asset_map.json
